# AI智能助手 - 环境变量配置示例
# 复制此文件为 .env 并填入您的真实密钥

# DeepSeek API 密钥（必需）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API 密钥（可选，用于 GPT 模型）
OPENAI_API_KEY=your_openai_api_key_here

# 向量嵌入服务密钥（记忆模块必需，小写变量名由代码读取）
# 未配置时语义检索会降级为本地 sentence-transformers，再降级为全零伪嵌入（结果不可信）
api_key=your_apiyi_api_key_here

# ChromaDB 记忆库路径
# 留空即可：程序会自动使用「仓库根目录/chroma_db」，打包后为 EXE 同级目录的 chroma_db。
# 仅当需要把记忆库放到别处时才取消注释，并且必须使用绝对路径——
# 相对路径会随启动目录变化，导致读写落到不同的数据库上。
# CHROMA_DB_PATH=C:\Users\yourname\ai-assistant\chroma_db

# 访问口令（对外暴露服务时必填）
# 留空=不鉴权，仅适合本机开发。一旦通过隧道或服务器对公网开放，必须设置，
# 否则任何人都能拿到地址白刷你的模型额度。前端在「设置 → 连接」里填这个值。
ACCESS_TOKEN=

# 服务器配置（通常无需修改）
HOST=127.0.0.1
PORT=8000
