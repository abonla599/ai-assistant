# AI智能助手 - 环境变量配置示例
# 复制此文件为 .env 并填入您的真实密钥

# DeepSeek API 密钥（必需）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API 密钥（可选，用于 GPT 模型）
OPENAI_API_KEY=your_openai_api_key_here

# 向量嵌入服务密钥（记忆模块必需，小写变量名由代码读取）
# 未配置时语义检索会降级为本地 sentence-transformers，再降级为全零伪嵌入（结果不可信）
api_key=your_apiyi_api_key_here

# ChromaDB 记忆库路径
# 留空即可：源码版与桌面版共用「项目根/chroma_db」。打包版 exe 位于 dist\run_backend\
# 时会向上找到自己的项目根，所以它读的也是同一份，不会各存一份记忆。
# 只有当 EXE 被整目录拷到别处、向上找不到项目根时，才退回 EXE 同级目录。
# 仅当需要把记忆库放到别处时才取消注释，并且必须使用绝对路径——
# 相对路径会随启动目录变化，导致读写落到不同的数据库上。
# CHROMA_DB_PATH=C:\Users\yourname\ai-assistant\chroma_db

# ==================== 访问凭据与鉴权模式 ====================
# 与「设置 → 连接」的关系（这一段务必读完，它决定别人能不能拿到管理员权限）：
#   管理员 = 只有您自己用这把 ACCESS_TOKEN；
#   其他每个人 = 自己填「用户名 + 密码」注册或登录，换回一枚属于他个人的、
#                可单独撤销的令牌（256 位随机串，服务端只存 SHA-256 摘要；
#                密码本身用 bcrypt 存，同样不是明文）。
# 任何用户都不该被要求填 ACCESS_TOKEN：那把口令一发出去，对方就是 admin，
# 能改写模型服务配置（含密钥）、列出/停用/删除用户。
# 完整规则见 docs/安装部署指南.md 的「🔐 多用户部署」一节。

# bootstrap 管理员口令（对外提供多人服务时必填）
# - 它解析成的身份是固定的：user_id=default_user、用户名「本机管理员」、role=admin。
# - 用途只有两个：让本机 EXE 和已经发出去的 APK 不改配置继续可用；
#   以及作为管理员使用 /admin 管理页与 /v1/admin/* 接口时的那把凭据。
# - 留空不再是"不鉴权"：AUTH_MODE 非 disabled、ACCESS_TOKEN 为空、且 data\users.json
#   里没有任何 role=admin 的人时，所有受保护端点一律返回
#   503 {"detail":"服务端未配置访问凭据"}。这是刻意的 fail-closed——
#   忘配 env 绝不等于把一台 API 公网敞开。
# - 绝不要写进任何分发物（APK、前端静态文件、日志、公开仓库），也不要发给用户。
#   本仓已经因 .env 被跟踪导致 API Key 公开五个月付出过代价。
ACCESS_TOKEN=

# 鉴权模式。判定只看字符串是否等于 disabled，写错（dissabled、false、空串）
# 都落到 enforced 那一侧——未知取值按安全侧处理，这条有测试钉着。
#   不配置 / enforced / 任何其它取值：每条 /v1/（以及 /docs、/redoc、/openapi.json）
#       都要凭据，匿名 401；文档路由在启动时就不生成。任何可能被外人访问到的
#       部署都用这个（默认）。
#   disabled：所有请求一律以「本机管理员」身份运行，启动时打印一行警告，
#       文档路由照常开。只用于本机开发。
# AUTH_MODE=enforced

# 注册是开放的（不需要邀请码、也不需要管理员参与），唯一的闸门是按**真实访客 IP**
# 限流：每个来源每天最多注册 3 个账号，撞名与猜密码各扣一格失败预算。
# 因此 ACCESS_TOKEN 比过去更要看好——拿到它的人既能改模型配置，也能删用户。
# 唯一的提权口子仍是手工改库：把 data\users.json 里某人的 role 改成 "admin"。
# 注意身份库不会热加载，改完必须重启服务，详见安装部署指南的排障对照表。

# 可变运行时数据放在哪（全部可选，留空即用默认位置）
# 默认都在「项目根\data\」下，一份用户数据都不例外。优先级：
#   环境变量 > <项目根>\data\<文件> > <项目根>\<文件>（只为兼容老数据，见指南）
# 需要把数据挪到别的盘、或做测试隔离时，取消注释并填**绝对路径**
# （相对路径会随启动目录漂移，读写会落到不同的库上）。
#   SESSION_DB_PATH      data\sessions.json        会话
#   USERS_DB_PATH        data\users.json           身份库（密码与会话令牌都只存摘要）
#   PROVIDERS_DB_PATH    data\providers.json       模型服务配置（含密钥）
#   UPLOAD_DIR           data\uploads\             附件
#   FEEDBACK_FILE        data\feedback.json        反馈原文
#   PREFERENCE_FILE      data\preference.txt       偏好摘要（本机管理员那份）
#   CHROMA_DB_PATH       chroma_db\                长期记忆向量库（见上文）
# ⚠️ 绝不能指向 dist\run_backend\ 里面：PyInstaller 重建会整体删除该目录
#    （2026-09-16 就真实丢过一次数据）。
# ⚠️ 一个 data 根目录**只能有一个服务进程**：这些存储用进程内锁串行化，
#    两个进程同时写同一份文件会互相覆盖。
# SESSION_DB_PATH=C:\Users\yourname\ai-assistant\data\sessions.json
# USERS_DB_PATH=C:\Users\yourname\ai-assistant\data\users.json
# PROVIDERS_DB_PATH=C:\Users\yourname\ai-assistant\data\providers.json
# UPLOAD_DIR=C:\Users\yourname\ai-assistant\data\uploads
# FEEDBACK_FILE=C:\Users\yourname\ai-assistant\data\feedback.json
# PREFERENCE_FILE=C:\Users\yourname\ai-assistant\data\preference.txt

# 服务器配置（通常无需修改）
HOST=127.0.0.1
PORT=8000
